import os
import json
from openai import OpenAI

ENABLE_AI = True # change False if network blocks OpenAI
AI_MAX_ROWS = 10 # first test with 10/50, then increase
AI_MODEL = "gpt-4.1-mini"

client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))


def safe_json_loads(text):
    try:
        return json.loads(text)
    except Exception:
        text = text.strip()
        text = text.replace("```json", "").replace("```", "").strip()
        return json.loads(text)


def ai_review_lineage(row):
    prompt = f"""
You are a SQL column-level lineage expert.

Goal:
Return final physical lineage for one MicroStrategy logical table column.

Rules:
1. Use only columns visible in SQL or parser output.
2. Do not invent schema/table/column.
3. Resolve aliases to physical schema.table.column.
4. For CASE expressions:
   - Include value column.
   - Include filter/condition column only if it controls the value.
5. If parser output is already correct, keep it.
6. Return comma-separated values if multiple physical columns exist.
7. Return JSON only.

JSON format:
{{
  "ai_suggested_schema": "",
  "ai_suggested_table": "",
  "ai_suggested_column": "",
  "ai_final_source_columns": "",
  "ai_reason": "",
  "ai_confidence": "High"
}}

Input:
columnName: {row.get(COL_COLUMN_NAME, "")}
Datasource: {row.get(COL_DATASOURCE, "")}
match_method: {row.get("match_method", "")}
mapping_type: {row.get("mapping_type", "")}
select_expression: {row.get("select_expression", "")}

Parser Output:
actual_source_columns: {row.get("actual_source_columns", "")}
actual_schema: {row.get("actual_schema", "")}
actual_table: {row.get("actual_table", "")}
actual_column: {row.get("actual_column", "")}

Full SQL:
{row.get(COL_SQL_QUERY, "")}
"""

    try:
        response = client.chat.completions.create(
            model=AI_MODEL,
            messages=[
                {"role": "system", "content": "Return only valid JSON. No markdown."},
                {"role": "user", "content": prompt}
            ],
            temperature=0
        )

        content = response.choices[0].message.content.strip()
        return safe_json_loads(content)

    except Exception as e:
        return {
            "ai_suggested_schema": "",
            "ai_suggested_table": "",
            "ai_suggested_column": "",
            "ai_final_source_columns": "",
            "ai_reason": f"AI review failed: {repr(e)}",
            "ai_confidence": "Low"
        }


# Create AI columns if missing
for col in [
    "ai_suggested_schema",
    "ai_suggested_table",
    "ai_suggested_column",
    "ai_final_source_columns",
    "ai_reason",
    "ai_confidence"
]:
    if col not in out_df.columns:
        out_df[col] = ""


if ENABLE_AI:
    review_indexes = out_df[
    (out_df["manual_review_flag"] == "Yes") &
    (out_df["parse_status"] == "Success")
    ].index.tolist()

    # Start small for safety
    review_indexes = review_indexes[:AI_MAX_ROWS]

    for idx in review_indexes:
        row = out_df.loc[idx]
        ai_result = ai_review_lineage(row)

        out_df.at[idx, "ai_suggested_schema"] = ai_result.get("ai_suggested_schema", "")
        out_df.at[idx, "ai_suggested_table"] = ai_result.get("ai_suggested_table", "")
        out_df.at[idx, "ai_suggested_column"] = ai_result.get("ai_suggested_column", "")
        out_df.at[idx, "ai_final_source_columns"] = ai_result.get("ai_final_source_columns", "")
        out_df.at[idx, "ai_reason"] = ai_result.get("ai_reason", "")
        out_df.at[idx, "ai_confidence"] = ai_result.get("ai_confidence", "Low")

            # ✅ Handle CONSTANT columns (AI detects no source column)
        if (
            not ai_result.get("ai_suggested_column")
            and "constant" in ai_result.get("ai_reason", "").lower()
        ):
            out_df.at[idx, "final_schema"] = ""
            out_df.at[idx, "final_table"] = ""
            out_df.at[idx, "final_column"] = "CONSTANT_VALUE"
            out_df.at[idx, "final_source_columns"] = "CONSTANT_VALUE"
            out_df.at[idx, "manual_review_flag"] = "No"

        # If AI gives a final answer, update final lineage
        if ai_result.get("ai_suggested_column"):
            out_df.at[idx, "final_schema"] = ai_result.get("ai_suggested_schema", "")
            out_df.at[idx, "final_table"] = ai_result.get("ai_suggested_table", "")
            out_df.at[idx, "final_column"] = ai_result.get("ai_suggested_column", "")
            out_df.at[idx, "final_source_columns"] = ai_result.get("ai_final_source_columns", "")

            if ai_result.get("ai_confidence") in ["High", "Medium"]:
                out_df.at[idx, "manual_review_flag"] = "AI Reviewed"

final_cols = [
    COL_PROJECT_NAME,
    COL_PROJECT_ID,
    COL_OBJECT_ID,
    COL_COLUMN_NAME,
    COL_COLUMN_ID,
    COL_DATASOURCE,
    "used_dialect",
    "excel_column_position",
    "match_method",
    "select_position_from_sql",
    "sql_output_column",
    "select_expression",
    "actual_source_columns",
    "actual_source_tables",
    "actual_schema",
    "actual_table",
    "actual_column",
    "mapping_type",
    "confidence",
    "manual_review_flag",
    "ai_suggested_schema",
    "ai_suggested_table",
    "ai_suggested_column",
    "ai_final_source_columns",
    "ai_reason",
    "ai_confidence",
    "final_source_columns",
    "final_schema",
    "final_table",
    "final_column",
    "parse_status",
    "parse_error",
    COL_SQL_QUERY
]

remaining_cols = [c for c in out_df.columns if c not in final_cols]
out_df = out_df[final_cols + remaining_cols]

out_df.to_excel(OUTPUT_FILE, index=False)

print("SQL lineage extraction completed.")
print(f"Output file created: {OUTPUT_FILE}")
