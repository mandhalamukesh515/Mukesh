df = pd.read_excel(INPUT_FILE)
df.columns = [c.strip() for c in df.columns]

required_cols = [
    COL_PROJECT_NAME,
    COL_PROJECT_ID,
    COL_OBJECT_ID,
    COL_COLUMN_NAME,
    COL_COLUMN_ID,
    COL_SQL_QUERY,
    COL_DATASOURCE
]

missing = [c for c in required_cols if c not in df.columns]
if missing:
    raise ValueError(f"Missing columns in input Excel: {missing}")

df[COL_SQL_QUERY] = df[COL_SQL_QUERY].apply(preprocess_sql)
df[COL_COLUMN_NAME] = df[COL_COLUMN_NAME].apply(clean_text)
df[COL_COLUMN_ID] = df[COL_COLUMN_ID].apply(clean_text)
df[COL_DATASOURCE] = df[COL_DATASOURCE].apply(clean_text)

# Position only within each logical table
df["excel_column_position"] = df.groupby(GROUP_COLUMNS).cumcount() + 1

query_cache = {}
output_rows = []

for _, row in df.iterrows():
    sql = row[COL_SQL_QUERY]
    datasource = row[COL_DATASOURCE]
    position = row["excel_column_position"]
    mstr_column_name = row[COL_COLUMN_NAME]

    cache_key = (
        row[COL_PROJECT_ID],
        row[COL_OBJECT_ID],
        datasource,
        sql
    )

    if cache_key not in query_cache:
        query_cache[cache_key] = build_query_mapping(sql, datasource)

    query_result = query_cache[cache_key]
    mappings = query_result["select_mappings"]

    matched_mapping, match_method = find_best_mapping(
        mstr_column_name=mstr_column_name,
        position=position,
        mappings=mappings
    )

    base_row = row.to_dict()

    if matched_mapping:
        mapping_type = matched_mapping["mapping_type"]
        source_cols = matched_mapping["actual_source_columns"]
        source_cols_list = [x.strip() for x in source_cols.split(",") if x.strip()]

        confidence = get_confidence(mapping_type, source_cols_list, match_method)

        manual_review = get_manual_review_flag(
            confidence=confidence,
            mapping_type=mapping_type,
            match_method=match_method,
            source_cols=source_cols_list
        )

        if "Review" in match_method:
            confidence = "Low"
            manual_review = "Yes"

        final_row = {
            **base_row,
            "used_dialect": query_result.get("used_dialect", ""),
            "match_method": match_method,
            "parse_status": query_result["parse_status"],
            "parse_error": query_result["parse_error"],
            **matched_mapping,
            "confidence": confidence,
            "manual_review_flag": manual_review,
            "final_source_columns": decide_final_source_columns(source_cols),
            "final_schema": matched_mapping["actual_schema"],
            "final_table": matched_mapping["actual_table"],
            "final_column": matched_mapping["actual_column"]
        }

    else:
        fallback_mapping, fallback_method = apply_regex_fallback(row, sql)

        if fallback_mapping:
            source_cols = fallback_mapping["actual_source_columns"]
            source_cols_list = [x.strip() for x in source_cols.split(",") if x.strip()]

            final_row = {
                **base_row,
                "used_dialect": query_result.get("used_dialect", ""),
                "match_method": fallback_method,
                "parse_status": query_result["parse_status"],
                "parse_error": query_result["parse_error"],
                **fallback_mapping,
                "confidence": "Medium" if source_cols_list else "Low",
                "manual_review_flag": "Yes",
                "final_source_columns": source_cols,
                "final_schema": fallback_mapping["actual_schema"],
                "final_table": fallback_mapping["actual_table"],
                "final_column": fallback_mapping["actual_column"]
            }

        else:
            final_row = {
                **base_row,
                "used_dialect": query_result.get("used_dialect", ""),
                "match_method": match_method,
                "parse_status": query_result["parse_status"],
                "parse_error": query_result["parse_error"] or "No matching SELECT expression found",
                "select_position_from_sql": "",
                "sql_output_column": "",
                "sql_output_column_normalized": "",
                "select_expression": "",
                "actual_source_columns": "",
                "actual_source_tables": "",
                "actual_schema": "",
                "actual_table": "",
                "actual_column": "",
                "mapping_type": "Not Mapped",
                "confidence": "Low",
                "manual_review_flag": "Yes",
                "final_source_columns": "",
                "final_schema": "",
                "final_table": "",
                "final_column": ""
            }
    output_rows.append(final_row)

out_df = pd.DataFrame(output_rows)

