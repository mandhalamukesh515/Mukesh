# =====================================================
# HELPERS
# =====================================================
def clean_text(value):
    if pd.isna(value):
        return ""
    return str(value).strip()


def normalize_sql(sql):
    sql = clean_text(sql)
    sql = sql.replace("\r", " ").replace("\n", " ")
    sql = re.sub(r"\s+", " ", sql)
    return sql.strip()


def normalize_name(name):
    name = clean_text(name)
    name = name.replace('"', "")
    name = name.replace("'", "")
    name = name.replace("[", "").replace("]", "")
    name = name.replace("`", "")
    return name.strip().upper()


def unique_keep_order(items):
    seen = set()
    result = []

    for item in items:
        if not item:
            continue

        item = str(item).strip()
        if not item:
            continue

        key = item.upper()
        if key not in seen:
            seen.add(key)
            result.append(item)

    return result


def expr_to_sql(expression, dialect=None):
    try:
        return expression.sql()
    except Exception:
        return str(expression)

def preprocess_sql(sql):
    sql = clean_text(sql)

    # remove comments
    sql = re.sub(r"--.*?(\n|$)", " ", sql)
    sql = re.sub(r"/\*.*?\*/", " ", sql, flags=re.DOTALL)

    # normalize spaces
    sql = sql.replace("\r", " ").replace("\n", " ")
    sql = re.sub(r"\s+", " ", sql).strip()

    # Teradata SEL shorthand
    if re.match(r"^SEL\s+", sql, flags=re.IGNORECASE):
        sql = re.sub(r"^SEL\s+", "SELECT ", sql, flags=re.IGNORECASE)

    # remove ending semicolon
    sql = sql.rstrip(";")

    return sql

def parse_sql(sql, datasource):
    dialect = get_dialect_from_datasource(datasource)

    # First try datasource dialect
    if dialect:
        try:
            return sqlglot.parse_one(sql, read=dialect), dialect
        except Exception:
            pass

    # Then try generic
    try:
        return sqlglot.parse_one(sql), "generic"
    except Exception:
        return None, dialect or "generic"


# =====================================================
# TABLE / SUBQUERY ALIAS MAP
# =====================================================
def get_clean_table_name(table_expr):
    """
    Returns clean physical table name without alias.
    Example:
    dp_jira_vew.vw_jiraissue AS ji -> dp_jira_vew.vw_jiraissue
    """
    parts = []

    if table_expr.catalog:
        parts.append(str(table_expr.catalog))

    if table_expr.db:
        parts.append(str(table_expr.db))

    if table_expr.name:
        parts.append(str(table_expr.name))

    return ".".join(parts)


def get_select_alias_map(select_exprs):
    """
    For subquery:
    SELECT issue AS issue_key, label AS s_label FROM vw_label

    returns:
    issue_key -> issue
    s_label   -> label
    """
    alias_map = {}

    for select_expr in select_exprs:
        alias = select_expr.alias
        base_expr = select_expr.this if isinstance(select_expr, exp.Alias) else select_expr

        if isinstance(base_expr, exp.Column):
            source_col = base_expr.name
        else:
            source_col = expr_to_sql(base_expr)

        if alias:
            alias_map[normalize_name(alias)] = source_col
        elif isinstance(base_expr, exp.Column):
            alias_map[normalize_name(base_expr.name)] = base_expr.name

    return alias_map


def get_subquery_alias_map(parsed):
    """
    Resolves simple subquery aliases.

    Example:
    LEFT JOIN (
        SELECT issue AS issue_key, label AS s_label
        FROM dp_jira_vew.vw_label
    ) lbl

    Output:
    LBL.S_LABEL   -> dp_jira_vew.vw_label.label
    LBL.ISSUE_KEY -> dp_jira_vew.vw_label.issue
    """
    result = {}

    if parsed is None:
        return result

    for subquery in parsed.find_all(exp.Subquery):
        sub_alias = subquery.alias
        if not sub_alias:
            continue

        sub_select = subquery.this.find(exp.Select) if subquery.this else None
        if sub_select is None:
            continue

        sub_tables = list(subquery.find_all(exp.Table))
        if not sub_tables:
            continue

        # Resolve simple subqueries with one main table
        physical_table = get_clean_table_name(sub_tables[0])

        sub_select_exprs = list(sub_select.expressions)
        alias_to_source_col = get_select_alias_map(sub_select_exprs)

        for alias_col, source_col in alias_to_source_col.items():
            result[f"{normalize_name(sub_alias)}.{alias_col}"] = f"{physical_table}.{source_col}"

    return result


def get_table_alias_map(parsed):
    alias_map = {}

    if parsed is None:
        return alias_map

    for table in parsed.find_all(exp.Table):
        clean_table = get_clean_table_name(table)

        alias = table.alias
        if alias:
            alias_map[normalize_name(alias)] = clean_table

        real_name = table.name
        if real_name:
            alias_map[normalize_name(real_name)] = clean_table

    return alias_map


# =====================================================
# SQL SELECT EXTRACTION
# =====================================================
def get_select_expressions(parsed):
    if parsed is None:
        return []

    select = parsed.find(exp.Select)
    if select is None:
        return []

    return list(select.expressions)


def get_output_alias(select_expr, position):
    alias = select_expr.alias

    if alias:
        return alias

    base_expr = select_expr.this if isinstance(select_expr, exp.Alias) else select_expr

    if isinstance(base_expr, exp.Column):
        return base_expr.name

    return f"SELECT_COL_{position}"


def extract_source_columns(select_expr, alias_map, subquery_alias_map):
    source_cols = []
    source_tables = []

    for col in select_expr.find_all(exp.Column):
        col_name = col.name
        table_alias = col.table

        if table_alias:
            alias_key = normalize_name(table_alias)
            subquery_key = f"{alias_key}.{normalize_name(col_name)}"

            # Resolve subquery column first
            if subquery_key in subquery_alias_map:
                full_col = subquery_alias_map[subquery_key]
                physical_table = ".".join(full_col.split(".")[:-1])
            else:
                actual_table = alias_map.get(alias_key, table_alias)
                full_col = f"{actual_table}.{col_name}"
                physical_table = actual_table

            source_cols.append(full_col)
            source_tables.append(physical_table)
        else:
            source_cols.append(col_name)

    return unique_keep_order(source_cols), unique_keep_order(source_tables)


def split_schema_table_column(full_col):
    full_col = str(full_col)

    # Remove any remaining alias junk
    full_col = re.sub(r"\s+AS\s+\w+", "", full_col, flags=re.IGNORECASE)

    full_col = full_col.replace('"', "")
    full_col = full_col.replace("`", "")
    full_col = full_col.replace("[", "").replace("]", "")

    parts = [p.strip() for p in full_col.split(".") if p.strip()]

    if len(parts) >= 4:
        return parts[-3], parts[-2], parts[-1]

    if len(parts) == 3:
        return parts[0], parts[1], parts[2]

    if len(parts) == 2:
        return "", parts[0], parts[1]

    if len(parts) == 1:
        return "", "", parts[0]

    return "", "", ""


def get_mapping_type(select_expr, dialect=None):
    expr_sql = expr_to_sql(select_expr)
    base_expr = select_expr.this if isinstance(select_expr, exp.Alias) else select_expr

    has_case = base_expr.find(exp.Case) is not None
    has_agg = re.search(r"\b(SUM|COUNT|AVG|MIN|MAX)\s*\(", expr_sql, flags=re.IGNORECASE)
    has_func = re.search(
        r"\b(CONCAT|CAST|TRIM|SUBSTR|SUBSTRING|UPPER|LOWER|COALESCE|NVL|ROUND|DATE|TRUNC|TO_CHAR)\s*\(",
        expr_sql,
        flags=re.IGNORECASE
    )

    if isinstance(base_expr, exp.Column):
        return "Direct"

    if has_case and has_agg:
        return "Case + Aggregation"

    if has_case:
        return "Case"

    if base_expr.find(exp.Subquery):
        return "Subquery"

    if has_agg:
        return "Aggregation"

    if has_func:
        return "Function"

    if any(op in expr_sql for op in ["+", "-", "*", "/"]):
        return "Calculation"

    return "Expression"


def get_confidence(mapping_type, source_cols, match_method):
    if not source_cols:
        return "Low"

    if match_method in ["Alias Match", "Direct Column Name Match"]:
        return "High"

    if match_method in ["Regex Alias Match"]:
        return "Medium"

    if match_method in ["Position Fallback", "Regex Position Match"]:
        return "Medium"

    return "Medium"


def get_manual_review_flag(confidence, mapping_type, match_method, source_cols):
    if not source_cols:
        return "Yes"

    # Strong matches are trusted even for CASE / Aggregation
    if match_method in ["Alias Match", "Direct Column Name Match"] and confidence == "High":
        return "No"

    # Regex alias match is acceptable but keep review
    if match_method == "Regex Alias Match":
        return "Yes"

    # Position-based mappings need review
    if match_method in ["Position Fallback", "Regex Position Match"]:
        return "Yes"

    if mapping_type in ["Not Mapped"]:
        return "Yes"

    return "Yes"


# =====================================================
# BUILD SQL SELECT MAP
# =====================================================
def build_query_mapping(sql, datasource):
    sql = preprocess_sql(sql)
    parsed, used_dialect = parse_sql(sql, datasource)

    if parsed is None:
        return {
            "parse_status": "Failed",
            "parse_error": "Unable to parse SQL",
            "used_dialect": used_dialect,
            "select_mappings": []
        }

    alias_map = get_table_alias_map(parsed)
    subquery_alias_map = get_subquery_alias_map(parsed)
    select_exprs = get_select_expressions(parsed)

    mappings = []

    for idx, select_expr in enumerate(select_exprs, start=1):
        select_expression = expr_to_sql(select_expr)
        sql_output_column = get_output_alias(select_expr, idx)

        source_cols, source_tables = extract_source_columns(
            select_expr=select_expr,
            alias_map=alias_map,
            subquery_alias_map=subquery_alias_map
        )

        mapping_type = get_mapping_type(select_expr)

        schemas = []
        tables = []
        columns = []

        for full_col in source_cols:
            schema, table, column = split_schema_table_column(full_col)
            schemas.append(schema)
            tables.append(table)
            columns.append(column)

        mappings.append({
            "select_position_from_sql": idx,
            "sql_output_column": sql_output_column,
            "sql_output_column_normalized": normalize_name(sql_output_column),
            "select_expression": select_expression,
            "actual_source_columns": ", ".join(source_cols),
            "actual_source_tables": ", ".join(unique_keep_order(source_tables)),
            "actual_schema": ", ".join(unique_keep_order(schemas)),
            "actual_table": ", ".join(unique_keep_order(tables)),
            "actual_column": ", ".join(unique_keep_order(columns)),
            "mapping_type": mapping_type
        })

    return {
        "parse_status": "Success",
        "parse_error": "",
        "used_dialect": used_dialect,
        "select_mappings": mappings
    }


def find_best_mapping(mstr_column_name, position, mappings):
    target = normalize_name(mstr_column_name)

    # 1. Alias/output column match
    alias_matches = [
        m for m in mappings
        if m["sql_output_column_normalized"] == target
    ]

    if len(alias_matches) == 1:
        return alias_matches[0], "Alias Match"

    if len(alias_matches) > 1:
        return alias_matches[0], "Multiple Alias Match - Review"

    # 2. Direct source column name match
    direct_matches = []

    for m in mappings:
        actual_cols = [
            normalize_name(x.strip())
            for x in m["actual_column"].split(",")
            if x.strip()
        ]

        if target in actual_cols:
            direct_matches.append(m)

    if len(direct_matches) == 1:
        return direct_matches[0], "Direct Column Name Match"

    if len(direct_matches) > 1:
        return direct_matches[0], "Multiple Source Column Match - Review"

    # 3. Position fallback
    for m in mappings:
        if m["select_position_from_sql"] == position:
            return m, "Position Fallback"

    return None, "No Match"


def decide_final_source_columns(source_cols):
    if source_cols:
        return source_cols
    return ""

# =====================================================
# V6 REGEX FALLBACK
# =====================================================
def split_select_items_regex(select_part):
    items = []
    current = []
    depth = 0
    in_single = False
    in_double = False

    for ch in select_part:
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "(" and not in_single and not in_double:
            depth += 1
        elif ch == ")" and not in_single and not in_double:
            depth -= 1

        if ch == "," and depth == 0 and not in_single and not in_double:
            items.append("".join(current).strip())
            current = []
        else:
            current.append(ch)

    if current:
        items.append("".join(current).strip())

    return items


def extract_select_part_regex(sql):
    m = re.search(r"\bselect\b(.*?)\bfrom\b", sql, flags=re.IGNORECASE | re.DOTALL)
    if not m:
        return ""

    return m.group(1).strip()


def get_alias_from_select_item(item, position):
    # col AS alias
    m = re.search(r"\s+as\s+([A-Za-z_][A-Za-z0-9_]*)\s*$", item, flags=re.IGNORECASE)
    if m:
        return m.group(1)

    # expression alias, example: concat(a,b) issue_num
    m = re.search(r"\s+([A-Za-z_][A-Za-z0-9_]*)\s*$", item)
    if m:
        possible_alias = m.group(1)
        if "." not in possible_alias and ")" in item:
            return possible_alias

    # direct column
    m = re.search(r"([A-Za-z_][A-Za-z0-9_]*)\s*$", item)
    if m:
        return m.group(1)

    return f"SELECT_COL_{position}"


def extract_source_cols_regex(select_item):
    # alias.column pattern
    cols = re.findall(
        r"\b([A-Za-z_][A-Za-z0-9_]*)\.([A-Za-z_][A-Za-z0-9_]*)\b",
        select_item
    )
    return [f"{a}.{c}" for a, c in cols]


def build_regex_fallback_mapping(sql):
    select_part = extract_select_part_regex(sql)
    if not select_part:
        return []

    select_items = split_select_items_regex(select_part)
    mappings = []

    for idx, item in enumerate(select_items, start=1):
        alias = get_alias_from_select_item(item, idx)
        source_cols = extract_source_cols_regex(item)

        mappings.append({
            "select_position_from_sql": idx,
            "sql_output_column": alias,
            "sql_output_column_normalized": normalize_name(alias),
            "select_expression": item,
            "actual_source_columns": ", ".join(unique_keep_order(source_cols)),
            "actual_source_tables": "",
            "actual_schema": "",
            "actual_table": "",
            "actual_column": ", ".join(
                unique_keep_order([c.split(".")[-1] for c in source_cols])
            ),
            "mapping_type": "Regex Fallback",
        })

    return mappings


def apply_regex_fallback(row, sql):
    fallback_mappings = build_regex_fallback_mapping(sql)

    if not fallback_mappings:
        return None, "Regex Fallback Failed"

    target = normalize_name(row[COL_COLUMN_NAME])
    position = row.get("excel_column_position", "")

    # alias match first
    for m in fallback_mappings:
        if m["sql_output_column_normalized"] == target:
            return m, "Regex Alias Match"

    # position fallback second
    for m in fallback_mappings:
        if m["select_position_from_sql"] == position:
            return m, "Regex Position Match"

    return None, "Regex No Match"


