def get_dialect_from_datasource(datasource):
    ds = str(datasource).strip().lower()

    if "singlestore" in ds:
        return "mysql"
    if "teradata" in ds:
        return "teradata"
    if "oracle" in ds:
        return "oracle"
    if "zira-oracle" in ds:
        return "oracle"
    if "vend connection-oracle" in ds:
        return "oracle"
    if "brp" in ds:
        return "oracle"
    if "trino" in ds:
        return "trino"
    if "mssql" in ds or "sql server" in ds or "sqlserver" in ds:
        return "tsql"
    if "bigdata" in ds or "big data" in ds:
        return "spark"
    if "tibco" in ds:
        return None

    return None


